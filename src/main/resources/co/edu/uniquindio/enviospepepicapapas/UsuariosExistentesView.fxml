<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.UsuariosExistentesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #FF441F; -fx-padding: 20;">
            <Label style="-fx-text-fill: white;">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #F8F8F8;">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

            <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="Usuarios Existentes">
                <font><Font size="18.0" /></font>
            </Label>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <ListView fx:id="listUsuarios" prefHeight="326.0" prefWidth="720.0" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8;" />
            </VBox>

            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#onEliminar" prefHeight="45" prefWidth="220" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10;" text="🗑️ Eliminar Seleccionado" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-text-fill: #666666;" text="Seleccione un usuario de la lista para eliminarlo">
                <font><Font size="12.0" /></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
