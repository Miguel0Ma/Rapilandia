<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.AgregarDireccionController"
      styleClass="content-area"
      stylesheets="@Style/styledashboard.css"
      spacing="20"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Header con título -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox.margin>
            <Insets bottom="10" />
        </VBox.margin>
        <Label text="📍" style="-fx-font-size: 36px;" />
        <VBox spacing="5">
            <Label text="Registrar Dirección" styleClass="title-primary" />
            <Label text="Agregue una nueva dirección frecuente" styleClass="text-secondary" />
        </VBox>
    </HBox>

    <Separator prefWidth="700" />

    <!-- Card contenedor del formulario -->
    <VBox styleClass="content-card" spacing="25" maxWidth="700" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>

        <!-- Grid del formulario -->
        <GridPane hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="140" prefWidth="140" />
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="400" />
            </columnConstraints>

            <!-- ID Dirección -->
            <Label text="ID Dirección" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtIdDireccion"
                       promptText="Identificador único de la dirección"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- Tipo de Dirección -->
            <Label text="Tipo de Dirección" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbTipo"
                      promptText="Seleccione el tipo (Casa, Oficina, etc.)"
                      styleClass="combo-box"
                      prefWidth="460"
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <!-- Calle -->
            <Label text="Dirección Completa" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtCalle"
                       promptText="Ej: Calle 15 #32-45, Apto 301"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <!-- Ciudad -->
            <Label text="Ciudad" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtCiudad"
                       promptText="Nombre de la ciudad"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <!-- Zona -->
            <Label text="Zona / Barrio" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtZona"
                       promptText="Barrio, localidad o zona"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="4" />
        </GridPane>

        <!-- Label para mensajes de error/éxito -->
        <Label fx:id="mensajeLabel"
               wrapText="true"
               visible="false"
               style="-fx-font-weight: bold; -fx-font-size: 14px;" />

        <!-- Botones de acción -->
        <HBox alignment="CENTER" spacing="15">
            <VBox.margin>
                <Insets top="20" />
            </VBox.margin>

            <Button text="💾 Guardar Dirección"
                    onAction="#onGuardar"
                    styleClass="btn-primary"
                    prefWidth="220"
                    prefHeight="50" />

            <Button text="🔄 Limpiar Campos"
                    onAction="#onLimpiar"
                    styleClass="btn-secondary"
                    prefWidth="200"
                    prefHeight="50" />

            <Button text="❌ Cancelar"
                    onAction="#onCancelar"
                    styleClass="btn-secondary"
                    prefWidth="150"
                    prefHeight="50" />
        </HBox>
    </VBox>

    <!-- Footer informativo -->
    <HBox alignment="CENTER" spacing="10">
        <VBox.margin>
            <Insets top="20" />
        </VBox.margin>
        <Label text="💡 Consejo:" styleClass="text-small" style="-fx-font-weight: bold;" />
        <Label text="Las direcciones guardadas facilitan envíos futuros más rápidos"
               styleClass="text-small" />
    </HBox>

</VBox>
