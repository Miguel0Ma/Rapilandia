<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.AgregarDireccionController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <Label text="RAPILANDIA EXPRESS">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

            <Label text="Registrar Dirección">
                <font><Font size="18.0" /></font>
            </Label>

            <GridPane hgap="15.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120" />
                    <ColumnConstraints halignment="LEFT" minWidth="250" />
                </columnConstraints>

                <Label text="ID Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtIdDireccion" promptText="Identificador de la dirección" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbTipo" promptText="Seleccione tipo de dirección" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Calle:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtCalle" promptText="Ej: Calle 15 #32-45" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtCiudad" promptText="Nombre de la ciudad" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Zona:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtZona" promptText="Barrio o zona" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#onGuardar" text="Guardar" />
                <Button onAction="#onLimpiar" text="Limpiar" />
                <Button onAction="#onCancelar" text="Cancelar" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <Label>
                <font><Font size="11.0" /></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
