<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.UsuarioController">

    <top>
        <BorderPane style="-fx-background-color: #FF441F; -fx-padding: 20;">
            <center>
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
            </center>
        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24.0" style="-fx-background-color: #F8F8F8;">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

            <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="Usuario · Gestión">
                <font><Font size="20.0" /></font>
            </Label>

            <GridPane hgap="16.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24;" vgap="14.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints halignment="LEFT" minWidth="300" />
                </columnConstraints>

                <Label style="-fx-text-fill: #333333;" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombre" promptText="Nombre completo" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-text-fill: #333333;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtEmail" promptText="correo@dominio.com" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-text-fill: #333333;" text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <PasswordField fx:id="txtPassword" promptText="Contraseña" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label style="-fx-text-fill: #333333;" text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cbTipo" promptText="Selecciona un tipo" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER" spacing="14.0">
                <Button onAction="#onGuardar" prefHeight="44.0" prefWidth="160.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10;" text="💾 Guardar" />
                <Button onAction="#onDuplicarUsuario" prefHeight="44.0" prefWidth="200.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10;" text="🧬 Duplicar usuario" />
                <Button onAction="#onCancelar" prefHeight="44.0" prefWidth="160.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="↩ Cancelar" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-text-fill: #666666;" text="Complete todos los campos para crear o editar un usuario">
                <font><Font size="12.0" /></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
