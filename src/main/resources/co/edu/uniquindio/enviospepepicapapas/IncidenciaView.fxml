<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.IncidenciaController" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #F8F8F8;">

    <top>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #FF441F; -fx-padding: 20;">
            <Label text="GESTIÓN DE INCIDENCIAS" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" style="-fx-background: #F8F8F8; -fx-background-color: #F8F8F8;">
            <VBox spacing="20.0" style="-fx-background-color: #F8F8F8;">
                <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="REGISTRAR NUEVA INCIDENCIA" style="-fx-text-fill: #FF441F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                    <GridPane hgap="15.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150.0"/>
                            <ColumnConstraints minWidth="400.0"/>
                        </columnConstraints>

                        <Label text="Envío:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #333333;" />
                        <ComboBox fx:id="cbEnvio" prefWidth="400.0" promptText="Seleccione el envío afectado" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-border-color: #E0E0E0;" />

                        <Label text="Tipo de Incidencia:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #333333;" />
                        <ComboBox fx:id="cbTipo" prefWidth="400.0" promptText="Seleccione el tipo" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: white; -fx-border-color: #E0E0E0;" />

                        <Label text="Zona:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #333333;" />
                        <TextField fx:id="txtZona" promptText="Ej: Norte, Sur, Centro" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #333333;" />
                        <TextArea fx:id="txtDescripcion" promptText="Describa detalladamente la incidencia..." prefHeight="100.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </GridPane>

                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button text="Registrar Incidencia" onAction="#onRegistrarIncidencia" prefWidth="180.0" prefHeight="35.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
                        <Button text="Limpiar" onAction="#onLimpiar" prefWidth="100.0" prefHeight="35.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;" />
                    </HBox>
                </VBox>

                <Separator style="-fx-background-color: #E0E0E0;" />

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="LISTA DE INCIDENCIAS REGISTRADAS" style="-fx-text-fill: #FF441F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                    <TableView fx:id="tablaIncidencias" prefHeight="300.0" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                            <TableColumn fx:id="colEnvio" text="Envío #" prefWidth="80.0"/>
                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150.0"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300.0"/>
                            <TableColumn fx:id="colZona" text="Zona" prefWidth="100.0"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0"/>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150.0"/>
                        </columns>
                    </TableView>

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="Filtrar por estado:" style="-fx-text-fill: #333333;" />
                        <ComboBox fx:id="cbFiltroEstado" promptText="Todos" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #E0E0E0;" />
                        <Button text="Aplicar Filtro" onAction="#onAplicarFiltro" prefWidth="120.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-background-radius: 8;" />
                        <Button text="Limpiar Filtros" onAction="#onLimpiarFiltros" prefWidth="120.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;" />
                    </HBox>
                </VBox>

                <Separator style="-fx-background-color: #E0E0E0;" />

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="RESOLVER INCIDENCIA SELECCIONADA" style="-fx-text-fill: #FF441F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                    <GridPane hgap="15.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150.0"/>
                            <ColumnConstraints minWidth="400.0"/>
                        </columnConstraints>

                        <Label text="Solución:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #333333;" />
                        <TextArea fx:id="txtSolucion" promptText="Describa cómo se resolvió la incidencia..." prefHeight="80.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </GridPane>

                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button text="Resolver Incidencia" onAction="#onResolverIncidencia" prefWidth="150.0" prefHeight="35.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
                        <Button text="Marcar En Proceso" onAction="#onMarcarEnProceso" prefWidth="150.0" prefHeight="35.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
                        <Button text="Ver Detalles" onAction="#onVerDetalles" prefWidth="120.0" prefHeight="35.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;" />
                        <Button text="Cancelar Incidencia" onAction="#onCancelarIncidencia" prefWidth="150.0" prefHeight="35.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;" />
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
            <Label text="Gestión de Incidencias - Rapilandia Express" style="-fx-text-fill: #666666;" />
        </HBox>
    </bottom>

</BorderPane>
