<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.IncidenciaController"
            prefHeight="700.0" prefWidth="1000.0">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="GESTIÓN DE INCIDENCIAS"/>
        </HBox>
    </top>

    <!-- Center -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox spacing="20.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

            <!-- Formulario para registrar incidencia -->
            <VBox spacing="15.0">
                <Label text="REGISTRAR NUEVA INCIDENCIA"/>

                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints minWidth="400.0"/>
                    </columnConstraints>

                    <!-- Seleccionar Envío -->
                    <Label text="Envío:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cbEnvio"
                              prefWidth="400.0"
                              promptText="Seleccione el envío afectado"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <!-- Tipo de Incidencia -->
                    <Label text="Tipo de Incidencia:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cbTipo"
                              prefWidth="400.0"
                              promptText="Seleccione el tipo"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <!-- Zona -->
                    <Label text="Zona:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtZona"
                               promptText="Ej: Norte, Sur, Centro"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <!-- Descripción -->
                    <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextArea fx:id="txtDescripcion"
                              promptText="Describa detalladamente la incidencia..."
                              prefHeight="100.0"
                              wrapText="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                </GridPane>

                <!-- Botón Registrar -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Registrar Incidencia"
                            onAction="#onRegistrarIncidencia"
                            prefWidth="180.0"
                            prefHeight="35.0"/>
                    <Button text="Limpiar"
                            onAction="#onLimpiar"
                            prefWidth="100.0"
                            prefHeight="35.0"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Tabla de Incidencias -->
            <VBox spacing="15.0">
                <Label text="LISTA DE INCIDENCIAS REGISTRADAS"/>

                <TableView fx:id="tablaIncidencias" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                        <TableColumn fx:id="colEnvio" text="Envío #" prefWidth="80.0"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150.0"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300.0"/>
                        <TableColumn fx:id="colZona" text="Zona" prefWidth="100.0"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150.0"/>
                    </columns>
                </TableView>

                <!-- Filtros -->
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <Label text="Filtrar por estado:"/>
                    <ComboBox fx:id="cbFiltroEstado"
                              promptText="Todos"
                              prefWidth="150.0"/>
                    <Button text="Aplicar Filtro"
                            onAction="#onAplicarFiltro"
                            prefWidth="120.0"/>
                    <Button text="Limpiar Filtros"
                            onAction="#onLimpiarFiltros"
                            prefWidth="120.0"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Sección para Resolver Incidencia -->
            <VBox spacing="15.0">
                <Label text="RESOLVER INCIDENCIA SELECCIONADA"/>

                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints minWidth="400.0"/>
                    </columnConstraints>

                    <Label text="Solución:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextArea fx:id="txtSolucion"
                              promptText="Describa cómo se resolvió la incidencia..."
                              prefHeight="80.0"
                              wrapText="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <rowConstraints>
                        <RowConstraints/>
                    </rowConstraints>
                </GridPane>

                <!-- Botones de Acción -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Resolver Incidencia"
                            onAction="#onResolverIncidencia"
                            prefWidth="150.0"
                            prefHeight="35.0"/>
                    <Button text="Marcar En Proceso"
                            onAction="#onMarcarEnProceso"
                            prefWidth="150.0"
                            prefHeight="35.0"/>
                    <Button text="Ver Detalles"
                            onAction="#onVerDetalles"
                            prefWidth="120.0"
                            prefHeight="35.0"/>
                    <Button text="Cancelar Incidencia"
                            onAction="#onCancelarIncidencia"
                            prefWidth="150.0"
                            prefHeight="35.0"/>
                </HBox>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>
            <Label text="Gestión de Incidencias - Rapilandia Express"/>
        </HBox>
    </bottom>

</BorderPane>