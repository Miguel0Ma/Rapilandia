<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.PagoViewController">

    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #FFD700;">
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20;">
                <Label style="-fx-text-fill: #000000; -fx-font-weight: bold;" text="GESTIÓN DE PAGOS">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #000000; -fx-background-color: #000000;">
            <VBox spacing="25.0" style="-fx-background-color: #000000;">
                <padding>
                    <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                </padding>

                <!-- Información del Envío -->
                <VBox spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="📦 INFORMACIÓN DEL ENVÍO">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <GridPane hgap="30.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" />
                        </columnConstraints>

                        <Label style="-fx-text-fill: #FFD700;" text="ID Envío:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblIdEnvio" style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="101" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font><Font size="14.0" /></font>
                        </Label>

                        <Label style="-fx-text-fill: #FFD700;" text="Origen:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblOrigen" style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="Cali" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <font><Font size="14.0" /></font>
                        </Label>

                        <Label style="-fx-text-fill: #FFD700;" text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblEstado" style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="SOLICITADO" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <font><Font size="14.0" /></font>
                        </Label>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>
                </VBox>

                <!-- Resumen del Costo -->
                <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #FFD700; -fx-padding: 25; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 20px;" text="MONTO A PAGAR" />
                    <Label fx:id="lblMontoPagar" style="-fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 36px;" text="15500.00" />
                    <Label style="-fx-text-fill: #000000; -fx-font-style: italic; -fx-font-size: 12px;" text="Incluye servicios adicionales" />
                </VBox>

                <!-- Método de Pago -->
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A; -fx-padding: 25; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="💳 SELECCIONAR MÉTODO DE PAGO">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <VBox spacing="15.0">
                        <!-- Tarjeta de Crédito/Débito -->
                        <RadioButton fx:id="rbTarjeta" selected="true" style="-fx-text-fill: #FFD700; -fx-font-size: 14px;" text="💳 Tarjeta de Crédito/Débito">
                            <toggleGroup>
                                <ToggleGroup fx:id="metodoPago" />
                            </toggleGroup>
                        </RadioButton>

                        <VBox fx:id="panelTarjeta" spacing="10.0">
                            <padding>
                                <Insets left="30.0" />
                            </padding>
                            <GridPane hgap="15.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                </columnConstraints>

                                <Label style="-fx-text-fill: #FFD700;" text="Número de Tarjeta:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtNumeroTarjeta" promptText="1234 5678 9012 3456" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-text-fill: #FFD700;" text="Titular:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtTitular" promptText="Nombre en la tarjeta" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-text-fill: #FFD700;" text="Vencimiento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <TextField fx:id="txtMes" prefWidth="60.0" promptText="MM" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" />
                                    <Label style="-fx-text-fill: #FFD700;" text="/">
                                        <font><Font size="16.0" /></font>
                                    </Label>
                                    <TextField fx:id="txtAnio" prefWidth="60.0" promptText="AA" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" />
                                </HBox>

                                <Label style="-fx-text-fill: #FFD700;" text="CVV:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="txtCVV" prefWidth="80.0" promptText="123" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                        </VBox>

                        <Separator style="-fx-background-color: #FFD700;" />

                        <!-- Transferencia Bancaria -->
                        <RadioButton fx:id="rbTransferencia" style="-fx-text-fill: #FFD700; -fx-font-size: 14px;" text="🏦 Transferencia Bancaria" toggleGroup="$metodoPago" />

                        <VBox fx:id="panelTransferencia" managed="false" spacing="10.0" visible="false">
                            <padding>
                                <Insets left="30.0" />
                            </padding>
                            <GridPane hgap="15.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                </columnConstraints>

                                <Label style="-fx-text-fill: #FFD700;" text="Cuenta Destino:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtCuentaDestino" promptText="Número de cuenta" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-prompt-text-fill: #808080; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-text-fill: #FFD700;" text="Banco:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <ComboBox fx:id="cmbBanco" prefWidth="350.0" promptText="Seleccione banco" style="-fx-background-color: #2A2A2A;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                        </VBox>

                        <Separator style="-fx-background-color: #FFD700;" />

                        <!-- Efectivo -->
                        <RadioButton fx:id="rbEfectivo" style="-fx-text-fill: #FFD700; -fx-font-size: 14px;" text="💵 Pago en Efectivo (Contra entrega)" toggleGroup="$metodoPago" />

                        <VBox fx:id="panelEfectivo" managed="false" spacing="10.0" visible="false">
                            <padding>
                                <Insets left="30.0" />
                            </padding>
                            <Label style="-fx-text-fill: #FFD700; -fx-font-style: italic;" text="El pago se realizará al momento de la entrega del envío.">
                                <font><Font size="13.0" /></font>
                            </Label>
                            <Label style="-fx-text-fill: #FFD700;" text="⚠️ Este método puede tener un recargo adicional del 5%.">
                                <font><Font size="12.0" /></font>
                            </Label>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Estado del Pago -->
                <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" text="📊 ESTADO DEL PAGO">
                        <font><Font size="18.0" /></font>
                    </Label>
                    <Label fx:id="lblEstadoPago" style="-fx-text-fill: #FFD700;" text="Pendiente">
                        <font><Font size="16.0" /></font>
                    </Label>
                </VBox>

                <!-- Botones de Acción -->
                <HBox alignment="CENTER" spacing="20.0">
                    <Button fx:id="btnProcesar" onAction="#onProcesarPago" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;" text="💳 Procesar Pago" />
                    <Button fx:id="btnRecibo" onAction="#onVerRecibo" prefHeight="50.0" prefWidth="180.0" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="📋 Ver Recibo" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #2A2A2A; -fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="❌ Cancelar" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-padding: 15;">
            <Label style="-fx-text-fill: #FFD700;" text="🔒 Transacción segura">
                <font><Font size="12.0" /></font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="20.0" />
            <Label style="-fx-text-fill: #FFD700;" text="Todos los pagos son procesados de forma segura">
                <font><Font size="12.0" /></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
