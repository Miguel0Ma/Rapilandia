<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.NotificacionController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #FF441F; -fx-padding: 15;">
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="26.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24.0">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

            <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="Notificaciones de Envío">
                <font><Font size="20.0" /></font>
            </Label>

            <GridPane hgap="16.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24;" vgap="14.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="160" />
                    <ColumnConstraints halignment="LEFT" minWidth="360" />
                </columnConstraints>

                <Label style="-fx-text-fill: #333333;" text="Mensaje:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMensaje" promptText="Escribe el mensaje" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-text-fill: #333333;" text="Canal:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbCanal" promptText="Selecciona canal" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER" spacing="14.0">
                <Button onAction="#onEnviar" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="📨 Enviar" />
                <Label fx:id="lblResultado" style="-fx-text-fill: #666666; -fx-font-size: 14px;" text="Estado: —" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-text-fill: #666666;" />
            <Separator orientation="VERTICAL" prefHeight="20.0" />
            <Label style="-fx-text-fill: #666666;" />
        </HBox>
    </bottom>

</BorderPane>
