<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="content-area" stylesheets="@Style/styleslogin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.DireccionesGuardadasController">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <!-- Header con título y descripción -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox.margin>
            <Insets bottom="10" />
        </VBox.margin>
        <Label style="-fx-font-size: 36px;" text="🏠" />
        <VBox spacing="5">
            <Label styleClass="title-primary" text="Direcciones Guardadas" />
            <Label styleClass="text-secondary" text="Gestione sus direcciones frecuentes de envío" />
        </VBox>
    </HBox>

    <Separator prefWidth="700" />

    <!-- Card contenedor del ListView -->
    <VBox maxWidth="750" spacing="20" styleClass="content-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- Instrucciones -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #FFF3E0; -fx-padding: 15px; -fx-background-radius: 8px;">
            <Label style="-fx-font-size: 20px;" text="ℹ️" />
            <Label styleClass="text-secondary" text="Seleccione una dirección de la lista para eliminarla" wrapText="true" />
        </HBox>

        <!-- ListView de direcciones -->
        <ListView fx:id="listDirecciones" prefHeight="350" prefWidth="690" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8px; -fx-background-radius: 8px;" />

        <!-- Label para mensajes -->
        <Label fx:id="mensajeLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" visible="false" wrapText="true" />

        <!-- Botones de acción -->
        <HBox alignment="CENTER" spacing="15">
            <VBox.margin>
                <Insets top="10" />
            </VBox.margin>

            <Button fx:id="btnEliminarDireccion" onAction="#eliminarDireccion" prefHeight="50" prefWidth="300" style="-fx-background-color: #FF441F;" styleClass="btn-primary" text="🗑️ Eliminar Dirección Seleccionada" />
        </HBox>
    </VBox>

    <!-- Footer con información -->
    <HBox alignment="CENTER" spacing="10">
        <VBox.margin>
            <Insets top="20" />
        </VBox.margin>
        <Label style="-fx-font-size: 14px;" text="📌" />
        <Label style="-fx-text-fill: #666666;" styleClass="text-small" text="Para agregar nuevas direcciones, utilice la opción 'Registrar Dirección' del menú" />
    </HBox>

</VBox>
