<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.AppViewController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #FFD700; -fx-padding: 20;">
            <Label style="-fx-text-fill: #000000; -fx-font-weight: bold;" text="RAPILANDIA EXPRESS">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox alignment="CENTER" spacing="30.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label style="-fx-text-fill: #FFD700;" text="Sistema de Gestión de Envíos">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>

            <!-- Menu Buttons -->
            <VBox alignment="CENTER" spacing="15.0">
                <Button fx:id="btnRegistrarEnvio" onAction="#onRegistrarEnvio" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Registrar Nuevo Envio" />

                <Button fx:id="btnHistorial" onAction="#onHistorialEnvios" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Historial de Envios" />

                <Button fx:id="btnPagos" onAction="#onGestionPagos" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Gestion de Pagos" />

                <Button fx:id="btnUsuarios" onAction="#onGestionUsuarios" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Gestion de Usuarios" />

                <Button fx:id="btnNotificaciones" onAction="#onNotificaciones" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Notificaciones" />
            </VBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-padding: 15;">
            <Label style="-fx-text-fill: #FFD700;">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="20.0" />
            <Label style="-fx-text-fill: #FFD700;">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
