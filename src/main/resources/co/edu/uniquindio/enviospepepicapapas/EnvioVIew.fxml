<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.EnvioViewController">

    <top>
        <VBox style="-fx-background-color: #FF441F;">
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20;">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="REGISTRAR NUEVO ENVÍO">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" prefWidth="912.0" style="-fx-background: #F8F8F8; -fx-background-color: #F8F8F8;">
            <VBox spacing="20.0" style="-fx-background-color: #F8F8F8;">
                <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="📦 INFORMACIÓN DEL ENVÍO">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <GridPane hgap="20.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="250.0" />
                        </columnConstraints>

                        <Label style="-fx-text-fill: #333333;" text="ID Envío:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtIdEnvio" promptText="Ej: 101" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label style="-fx-text-fill: #333333;" text="Origen:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtOrigen" promptText="Ciudad de origen" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label style="-fx-text-fill: #333333;" text="Peso (kg):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtPeso" promptText="Ej: 3.5" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label style="-fx-text-fill: #333333;" text="Prioridad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <CheckBox fx:id="chkPrioridad" style="-fx-text-fill: #333333;" text="Envío Prioritario" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </GridPane>
                </VBox>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="📏 DIMENSIONES DEL PAQUETE">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <HBox spacing="20.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #333333;" text="Alto (m):" />
                            <TextField fx:id="txtAlto" prefWidth="120.0" promptText="Ej: 1.2" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #333333;" text="Ancho (m):" />
                            <TextField fx:id="txtAncho" prefWidth="120.0" promptText="Ej: 0.8" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #333333;" text="Largo (m):" />
                            <TextField fx:id="txtLargo" prefWidth="120.0" promptText="Ej: 0.6" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #333333;" text="Volumen:" />
                            <Label fx:id="lblVolumen" style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="0.0 m³">
                                <font><Font size="16.0" /></font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="💰 ESTRATEGIA DE CÁLCULO">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label style="-fx-text-fill: #333333;" text="Método de cálculo:" />
                        <ComboBox fx:id="cmbEstrategia" prefWidth="250.0" promptText="Seleccione método" style="-fx-background-color: white; -fx-border-color: #E0E0E0;" />
                    </HBox>
                </VBox>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="📋 SERVICIOS ADICIONALES">
                        <font><Font size="18.0" /></font>
                    </Label>

                    <VBox spacing="10.0">
                        <CheckBox fx:id="chkFragil" style="-fx-text-fill: #333333;" text="📦 Frágil (+$10,000)" />
                        <CheckBox fx:id="chkSeguro" style="-fx-text-fill: #333333;" text="🛡️ Seguro Adicional" />
                        <CheckBox fx:id="chkExpreso" style="-fx-text-fill: #333333;" text="⚡ Entrega Express" />
                    </VBox>
                </VBox>

                <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #FF441F; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="COSTO TOTAL ESTIMADO" />
                    <Label fx:id="lblCostoTotal" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" text="0.00" />
                </VBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <Button fx:id="btnCalcular" onAction="#onCalcularCosto" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Calcular Costo" />
                    <Button fx:id="btnRegistrar" onAction="#onRegistrarEnvio" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Registrar Envío" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiarFormulario" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: white; -fx-text-fill: #FF441F; -fx-border-color: #FF441F; -fx-border-width: 2; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Limpiar" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
