<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.HistorialEnvioController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #FF441F; -fx-padding: 15;">
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="26.0" /></font>
            </Label>
        </HBox>
    </top>

    <!-- Center -->
    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

            <Label style="-fx-text-fill: #FF441F; -fx-font-weight: bold;" text="Historial de Envíos">
                <font><Font size="20.0" /></font>
            </Label>

            <TableView fx:id="tablaEnvios" prefHeight="360.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="140.0" text="ID" />
                    <TableColumn fx:id="colOrigen" prefWidth="240.0" text="Origen" />
                    <TableColumn fx:id="colPeso" prefWidth="120.0" text="Peso (kg)" />
                    <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
                    <TableColumn fx:id="colCosto" prefWidth="160.0" text="Costo ($)" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="12.0">
                <Label style="-fx-text-fill: #333333; -fx-font-weight: bold;" text="Nuevo estado:" />
                <ComboBox fx:id="cbEstado" promptText="Selecciona estado" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #E0E0E0;" />
                <Button onAction="#onActualizarEstado" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="🔄 Actualizar estado" />
                <Button onAction="#onVerDetalle" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="🔍 Ver detalle" />
            </HBox>

            <Label fx:id="lblInfo" style="-fx-text-fill: #666666;" text="—" />
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-text-fill: #666666;" />
            <Separator orientation="VERTICAL" prefHeight="20.0" />
            <Label style="-fx-text-fill: #666666;" />
        </HBox>
    </bottom>

</BorderPane>
