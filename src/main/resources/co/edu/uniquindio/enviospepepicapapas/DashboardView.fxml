<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="dashboard-container" stylesheets="@Style/styledashboard.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.DashboardViewController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label style="-fx-font-size: 32px;" text="🚚" />
            <VBox spacing="2">
                <Label style="-fx-text-fill: #FF441F;" styleClass="title-secondary" text="Envíos Pepe Pica Papas" />
                <Label style="-fx-font-size: 13px;" styleClass="text-secondary" text="Panel de Administración" />
            </VBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- User info -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label styleClass="form-label" text="Admin" />
                    <Label styleClass="text-small" text="admin@pepepicapapas.com" />
                </VBox>
                <Button style="-fx-font-size: 18px; -fx-min-width: 45px; -fx-min-height: 45px;" styleClass="btn-icon" text="👤" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #FF441F; -fx-padding: 30 20; -fx-pref-width: 260;">

            <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 0 10 10 10;" text="MENÚ PRINCIPAL" />

            <VBox spacing="8">
                <Button fx:id="btnRegistrarEnvio" onAction="#onRegistrarEnvio" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="📦  Registrar Envío" />

                <Button fx:id="btnHistorial" onAction="#onHistorialEnvios" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="📋  Historial de Envíos" />

                <Button fx:id="btnPagos" onAction="#onGestionPagos" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="💳  Gestión de Pagos" />

                <Button fx:id="btnUsuarios" onAction="#onGestionUsuarios" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="👥  Gestión de Usuarios" />

                <Button fx:id="btnDirecciones" onAction="#onAgregarDireccion" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="📍  Agregar Dirección" />

                <Button fx:id="btnDireccionesGuardadas" onAction="#onDireccionesGuardadas" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="📍  Direcciones Guardadas" />

                <Button fx:id="btnNotificaciones" onAction="#onNotificaciones" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="📢  Notificaciones" />

                <Button fx:id="btnUsuariosExistentes" onAction="#onUsuariosExistentes" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20;" text="👥  Usuarios Existentes" />
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout button at bottom -->
            <Button fx:id="cerrarSesion" onAction="#onCerrarSesion" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-alignment: CENTER-LEFT; -fx-padding: 0 20; -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 12;" text="🚪  Cerrar Sesión" />
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <BorderPane fx:id="contentPane" style="-fx-background-color: #F8F8F8; -fx-padding: 30;">
            <!-- Default welcome content -->
            <center>
                <VBox alignment="CENTER" maxWidth="600" spacing="30.0">
                    <VBox alignment="CENTER" spacing="15">
                        <Label style="-fx-font-size: 80px;" text="🎯" />
                        <Label style="-fx-text-fill: #333333;" styleClass="title-primary" text="Bienvenido al Dashboard" />
                        <Label style="-fx-font-size: 16px;" styleClass="text-secondary" text="Selecciona una opción del menú lateral para comenzar a gestionar tus envíos" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- Quick stats cards -->
                    <HBox alignment="CENTER" spacing="20">
                        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 160;">
                            <Label style="-fx-font-size: 35px;" text="📦" />
                            <Label style="-fx-text-fill: #FF441F;" styleClass="title-secondary" text="128" />
                            <Label styleClass="text-small" text="Envíos Activos" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 160;">
                            <Label style="-fx-font-size: 35px;" text="✅" />
                            <Label style="-fx-text-fill: #00D632;" styleClass="title-secondary" text="452" />
                            <Label styleClass="text-small" text="Completados" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 160;">
                            <Label style="-fx-font-size: 35px;" text="👥" />
                            <Label style="-fx-text-fill: #4A90E2;" styleClass="title-secondary" text="89" />
                            <Label styleClass="text-small" text="Usuarios" />
                        </VBox>
                    </HBox>
                </VBox>
            </center>
        </BorderPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
            <Label style="-fx-text-fill: #666666;" styleClass="text-small" text="© 2025 Envíos Pepe Pica Papas" />
            <Separator orientation="VERTICAL" prefHeight="15.0" />
            <Label style="-fx-text-fill: #666666;" styleClass="text-small" text="Dashboard v1.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #666666;" styleClass="text-small" text="Hecho con ❤️ en Colombia" />
        </HBox>
    </bottom>

</BorderPane>
