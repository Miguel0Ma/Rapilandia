<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.DashboardViewController"
            prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #000000;">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #FFD700; -fx-padding: 20;">
            <Label text="RAPILANDIA EXPRESS - DASHBOARD" style="-fx-text-fill: #000000; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20; -fx-pref-width: 200;">
            <Label text="NAVEGACIÓN" style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-font-size: 16px;"/>

            <Button fx:id="btnRegistrarEnvio" text="📦 Registrar Envío" prefWidth="180.0" prefHeight="40.0" onAction="#onRegistrarEnvio"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"/>

            <Button fx:id="btnHistorial" text="📋 Historial de Envíos" prefWidth="180.0" prefHeight="40.0" onAction="#onHistorialEnvios"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"/>

            <Button fx:id="btnPagos" text="💳 Gestión de Pagos" prefWidth="180.0" prefHeight="40.0" onAction="#onGestionPagos"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"/>

            <Button fx:id="btnUsuarios" text="👥 Gestión de Usuarios" prefWidth="180.0" prefHeight="40.0" onAction="#onGestionUsuarios"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"/>

            <Button fx:id="btnNotificaciones" text="📢 Notificaciones" prefWidth="180.0" prefHeight="40.0" onAction="#onNotificaciones"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <BorderPane fx:id="contentPane" style="-fx-background-color: #000000;">
            <!-- Default welcome content -->
            <center>
                <VBox alignment="CENTER" spacing="20.0">
                    <Label text="Bienvenido al Dashboard de Rapilandia Express" style="-fx-text-fill: #FFD700; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Selecciona una opción del menú lateral para comenzar" style="-fx-text-fill: #FFD700; -fx-font-size: 16px;"/>
                </VBox>
            </center>
        </BorderPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-padding: 15;">
            <Label text="© 2024 Rapilandia Express" style="-fx-text-fill: #FFD700;">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="20.0"/>
            <Label text="Dashboard v1.0" style="-fx-text-fill: #FFD700;">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>