<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.InicioSesionController"
           prefHeight="700.0" prefWidth="500.0"
           styleClass="main-background"
          stylesheets="@Style/styleslogin.css">

    <children>
        <!-- Contenedor principal con fondo blanco -->
        <VBox alignment="CENTER" spacing="0" maxWidth="450.0" maxHeight="650.0"
              styleClass="card-container">

            <padding>
                <Insets top="50" right="40" bottom="50" left="40"/>
            </padding>

            <!-- Logo o Título -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="🚚" style="-fx-font-size: 60px;" />
                <Label text="Envíos Pepe Pica Papas"
                       styleClass="title-secondary"
                       style="-fx-text-fill: #FF441F;" />
                <Label text="Bienvenido de nuevo"
                       styleClass="text-secondary" />
            </VBox>

            <!-- Espaciador -->
            <Region VBox.vgrow="ALWAYS" minHeight="40" maxHeight="40"/>

            <!-- Campo Tipo de Usuario -->
            <VBox spacing="8">
                <Label text="Tipo de usuario"
                       styleClass="form-label" />
                <ComboBox fx:id="tipoUsuarioComboBox"
                          prefWidth="370.0"
                          promptText="Selecciona tu rol">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Cliente" />
                            <String fx:value="Repartidor" />
                            <String fx:value="Administrador" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <!-- Espaciador -->
            <Region minHeight="20"/>

            <!-- Campo Correo -->
            <VBox spacing="8">
                <Label text="Correo electrónico"
                       styleClass="form-label" />
                <TextField fx:id="correoTextField"
                           promptText="tucorreo@ejemplo.com" />
            </VBox>

            <!-- Espaciador -->
            <Region minHeight="20"/>

            <!-- Campo Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña"
                       styleClass="form-label" />
                <PasswordField fx:id="contrasenaPasswordField"
                               promptText="••••••••" />
            </VBox>





            <!-- Espaciador -->
            <Region minHeight="30"/>

            <!-- Botón de Inicio de Sesión -->
            <Button fx:id="iniciarSesionButton"
                    text="Iniciar sesión"
                    onAction="#iniciarSesion"
                    styleClass="btn-primary"
                    maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="0"/>
                </VBox.margin>
            </Button>

            <!-- Espaciador -->
            <Region minHeight="15"/>

            <!-- Mensaje de error -->
            <Label fx:id="mensajeLabel"
                   text=""
                   wrapText="true"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   styleClass="text-error" />

            <!-- Espaciador -->
            <Region VBox.vgrow="ALWAYS" minHeight="20"/>

            <!-- Link de registro o ayuda -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="¿No tienes cuenta?"
                       styleClass="text-secondary" />
                <Label text="Regístrate"
                       styleClass="link" />
            </HBox>

        </VBox>
    </children>
</StackPane>