<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.SelectorEnviosController">

    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #FFD700;">
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20;">
                <Label style="-fx-text-fill: #000000; -fx-font-weight: bold;" text="SELECCIONAR ENVIO PARA PAGAR">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #000000;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <!-- Instrucciones -->
            <Label style="-fx-text-fill: #FFD700; -fx-font-size: 16px;" text="Seleccione el envio que desea pagar de la lista:" />

            <!-- Tabla de Envíos -->
            <TableView fx:id="tablaEnvios" prefHeight="400.0" style="-fx-background-color: #1A1A1A; -fx-control-inner-background: #1A1A1A;">
                <columns>
                    <TableColumn fx:id="colId" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colOrigen" prefWidth="200.0" text="Origen" />
                    <TableColumn fx:id="colPeso" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Peso (kg)" />
                    <TableColumn fx:id="colCosto" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Costo Total" />
                    <TableColumn fx:id="colEstado" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Estado" />
                </columns>
            </TableView>

            <!-- Botón de acción -->
            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="btnPagarSeleccionado" onAction="#onPagarSeleccionado" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #FFD700; -fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Proceder al Pago" />
            </HBox>

        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #1A1A1A; -fx-padding: 15;">
            <Label style="-fx-text-fill: #FFD700; -fx-font-size: 12px;" text="Seleccione un envio de la tabla y haga clic en Proceder al Pago" />
        </HBox>
    </bottom>

</BorderPane>
