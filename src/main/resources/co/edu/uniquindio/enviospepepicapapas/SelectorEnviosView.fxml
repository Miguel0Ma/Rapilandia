<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.enviospepepicapapas.Controllers.SelectorEnviosController">

    <top>
        <VBox style="-fx-background-color: #FF441F;">
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20;">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="SELECCIONAR ENVÍO PARA PAGAR">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #F8F8F8;">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

            <Label style="-fx-text-fill: #333333; -fx-font-size: 16px; -fx-font-weight: bold;" text="Seleccione el envío que desea pagar de la lista:" />

            <TableView fx:id="tablaEnvios" prefHeight="400.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colOrigen" prefWidth="200.0" text="Origen" />
                    <TableColumn fx:id="colPeso" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Peso (kg)" />
                    <TableColumn fx:id="colCosto" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Costo Total" />
                    <TableColumn fx:id="colEstado" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Estado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="btnPagarSeleccionado" onAction="#onPagarSeleccionado" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #FF441F; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Proceder al Pago" />
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Seleccione un envío de la tabla y haga clic en Proceder al Pago" />
        </HBox>
    </bottom>

</BorderPane>
